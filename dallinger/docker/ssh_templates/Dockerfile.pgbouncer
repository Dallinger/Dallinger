# Image for the PgBouncer connection pooler of docker-ssh apps. Nothing builds
# this file: docker_ssh.py reads the FROM line, and Dependabot keeps the pinned
# tag and digest current. Keep the digest, because this container holds the
# app's database password.
FROM edoburu/pgbouncer:v1.26.1-p0@sha256:488422e38cff912895d0d65d8963fcd306e6ac589a724398b6eb8e294e94d624
