# Image for the Cloudflare Tunnel connector of docker-ssh deployments. Nothing
# builds this file: docker_ssh.py reads the FROM line, and Dependabot keeps the
# pinned tag and digest current. Keep the digest, because this container holds
# the tunnel token.
FROM cloudflare/cloudflared:2026.10.5@sha256:1b1d34d0a9c0bfca9de72db8460d328db3f19edd2b96169114e3e893a97bbe53
