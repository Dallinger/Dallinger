# Image for the docker-ssh hibernation controller. Nothing builds this file:
# docker_ssh.py reads the FROM line, and Dependabot keeps the pinned tag and
# digest current. Keep the digest, because this container holds the Docker
# socket.
FROM python:3.14-alpine@sha256:f6a589d43c42b9e7f7dc67a12d37132491f362859a5d750607710cc56da3bc72
