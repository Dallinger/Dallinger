services:
  postgresql:
    image: postgres:12
    command: postgres -c jit=off
    restart: unless-stopped
    environment:
      POSTGRES_USER: dallinger
      POSTGRES_PASSWORD: dallinger
      POSTGRES_DB: dallinger
    volumes:
      - dallinger_pg_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U $${POSTGRES_USER}"]
      interval: 2s
      timeout: 5s
      retries: 15
      start_period: 300s
    stop_grace_period: 60s
    networks:
      - dallinger

  httpserver:
    image: caddy:2.10.2
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - ./caddy.d:/etc/caddy/caddy.d
      - ./root.d:/etc/caddy/root.d
      - caddy_config:/config
      - caddy_data:/data
    networks:
      - dallinger
  dozzle:
    container_name: dozzle
    restart: unless-stopped
    image: amir20/dozzle:v10.0.2
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./dozzle-users.yml:/data/users.yml
    environment:
      - DOZZLE_AUTH_PROVIDER=simple
    networks:
      - dallinger

volumes:
  dallinger_pg_data:
  caddy_config:
  caddy_data:

networks:
  dallinger:
    name: dallinger
