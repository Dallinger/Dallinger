services:
  postgresql:
    restart: "no"
    image: postgres:12
    container_name: {{ experiment_id }}_postgresql
    environment:
      POSTGRES_USER: {{ experiment_id }}
      POSTGRES_PASSWORD: {{ postgresql_password }}
      POSTGRES_DB: {{ experiment_id }}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ experiment_id }}"]
      interval: 2s
      timeout: 5s
    networks:
      app:
        aliases:
          - postgresql

  redis:
    restart: "no"
    image: redis
    command: redis-server --appendonly yes
    volumes:
      - redis_data:/data
    healthcheck:
        test: "[ $$(redis-cli ping) = 'PONG' ]"
        interval: 2s
        timeout: 1s
    networks:
      app:
        aliases:
          - {{ experiment_id }}_redis

  web:
    restart: "no"
    image: {{ experiment_image }}
    user: "${UID}:${GID}"
    command: dallinger_heroku_web
    depends_on: &commondepends
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
    environment: &commonenv
      REDIS_URL: redis://{{ experiment_id }}_redis:6379
      DATABASE_URL: postgresql://{{ experiment_id }}:{{ postgresql_password }}@{{ experiment_id }}_pgbouncer/{{ experiment_id }}
      HOME: /tmp
      HOST: 0.0.0.0
      PORT: 5000
    {%- for key, value in config.items() %}
      {{ key }}: {{ value | string() | tojson }}
    {%- endfor %}
    networks:
      app:
        aliases:
          - experiment-backend
    volumes:
      - ${HOME}/dallinger-data/{{ experiment_id }}:/var/lib/dallinger
    {%- if docker_volumes | length > 0 %}
      {%- for volume in docker_volumes.split(",") %}
      - {{ volume | string() }}
      {%- endfor %}
    {%- endif %}

  {% set num_dynos = config["num_dynos_worker"] | default('1') | int %}
  {%- for number in range(num_dynos) %}
  worker_{{ number + 1 }}:
    restart: "no"
    image: {{ experiment_image }}
    command: dallinger_heroku_worker
    cpu_shares: {{ config["docker_worker_cpu_shares"] }}
    depends_on:
      <<: *commondepends
    user: "${UID}:${GID}"
    environment:
      <<: *commonenv
    networks:
      - app
    volumes:
      - ${HOME}/dallinger-data/{{ experiment_id }}:/var/lib/dallinger
    {%- if docker_volumes | length > 0 %}
      {%- for volume in docker_volumes.split(",") %}
      - {{ volume | string() }}
      {%- endfor %}
    {%- endif %}
  {%- endfor %}

  pgbouncer:
    restart: "no"
    image: docker.io/bitnamilegacy/pgbouncer:1.24.1
    container_name: {{ experiment_id }}_pgbouncer
    depends_on:
      postgresql:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/127.0.0.1/5432'"]
      interval: 2s
      timeout: 5s
      retries: 15
    networks:
      app:
        aliases:
          - {{ experiment_id }}_pgbouncer
    environment:
      - POSTGRESQL_HOST=postgresql
      - PGBOUNCER_AUTH_TYPE=md5
      - PGBOUNCER_SET_DATABASE_USER=yes
      - PGBOUNCER_SET_DATABASE_PASSWORD=yes
      - POSTGRESQL_USERNAME={{ experiment_id }}
      - POSTGRESQL_PASSWORD={{ postgresql_password }}
      - PGBOUNCER_PORT=5432
      - PGBOUNCER_DATABASE={{ experiment_id }}
      - PGBOUNCER_POOL_MODE=transaction
      - PGBOUNCER_SERVER_IDLE_TIMEOUT=60

{%- if config["clock_on"] %}
  clock:
    restart: "no"
    image: {{ experiment_image }}
    user: "${UID}:${GID}"
    command: dallinger_heroku_clock
    depends_on:
      <<: *commondepends
    environment:
      <<: *commonenv
      PORT: 5000
    networks:
      - app
    volumes:
      - ${HOME}/dallinger-data/{{ experiment_id }}:/var/lib/dallinger
{%- endif %}

  cloudflared:
    restart: unless-stopped
    image: cloudflare/cloudflared:2026.9.1
    user: "${UID}:${GID}"
    command: ["tunnel", "--no-autoupdate", "run", "--token-file", "/run/secrets/cloudflare-tunnel-token"]
    environment:
      HOME: /tmp
    depends_on:
      frontdoor:
        condition: service_started
    volumes:
      - ./secrets/cloudflare-tunnel-token:/run/secrets/cloudflare-tunnel-token:ro
    networks:
      - app

  frontdoor:
    restart: unless-stopped
    image: caddy:2.10.2
    user: "${UID}:${GID}"
    environment:
      HOME: /state
      XDG_CONFIG_HOME: /state/caddy-config
      XDG_DATA_HOME: /state/caddy-data
    volumes:
      - ./Caddyfile.frontdoor:/etc/caddy/Caddyfile:ro
      - ./state:/state
    depends_on:
      controller:
        condition: service_started
    networks:
      app:
        aliases:
          - {{ experiment_id }}_frontdoor
          - {{ experiment_id }}_web

  controller:
    restart: unless-stopped
    image: {{ experiment_image }}
    user: "${UID}:${GID}"
    group_add:
      - "${DOCKER_GID}"
    command:
      - python
      - -c
      - "try:\n from dallinger.hibernation import serve_from_env\n serve_from_env()\nexcept ImportError:\n import time\n time.sleep(10**9)\n"
    environment:
      COMPOSE_PROJECT_NAME: {{ experiment_id | lower }}
      HIBERNATION_PROJECT: {{ experiment_id | lower }}
      HIBERNATION_SECRET: {{ hibernation_secret | tojson }}
      HIBERNATION_STATE_DIR: /state
      HIBERNATION_MANIFEST_PATH: /app/deployment.json
      DOCKER_SOCKET: /var/run/docker.sock
      WEB_ORIGIN: http://experiment-backend:5000
      IDLE_ENABLED: "{{ idle_enabled }}"
      IDLE_MINUTES: "{{ idle_minutes }}"
    volumes:
      - ./state:/state
      - ./deployment.json:/app/deployment.json
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - app

volumes:
  redis_data:
  postgres_data:

networks:
  app:
    name: {{ experiment_id }}_app
